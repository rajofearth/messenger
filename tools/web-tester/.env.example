# Copy this file to .env.local and fill in a test account.
# .env.local is ignored by git.
WEB_TESTER_USERNAME=webtester_2026
WEB_TESTER_PASSWORD=change-me

# Optional. The tester otherwise reads EXPO_PUBLIC_CONVEX_URL from the
# repository's .env.local.
# WEB_TESTER_CONVEX_URL=https://your-deployment.convex.cloud

# Optional control API settings. It binds to loopback by default.
# WEB_TESTER_CONTROL_HOST=127.0.0.1
# WEB_TESTER_CONTROL_PORT=8787
# WEB_TESTER_CONTROL_TOKEN=
