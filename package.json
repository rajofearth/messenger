{
  "name": "messenger",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "npm run android:build",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:build": "node scripts/android.mjs build",
    "android:install": "node scripts/android.mjs install",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && expo install --check"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
