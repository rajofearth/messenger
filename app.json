{
  "expo": {
    "name": "Messenger",
    "slug": "messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yashraj.messenger",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Messenger to record voice notes you choose to send.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Messenger to choose photos for messages, stories, and your profile.",
          "cameraPermission": "Allow Messenger to take photos for messages and stories.",
          "microphonePermission": "Allow Messenger to record audio when you capture a video to share."
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-image"
    ]
  }
}
